# Redis connection used by both the mock app (producer) and the consumer.
REDIS_URL=redis://redis:6379/0

# Mock app: how often (seconds) active faults emit RawEvents onto aegis:events.
EMIT_INTERVAL_S=0.5

# Consumer: backpressure / batching.
CONSUMER_NAME=c1
CONSUMER_BATCH=10
CONSUMER_BLOCK_MS=500
PENDING_HIGH_WATER=100

# Consumer: deduplication and correlation window tuning (seconds).
DEDUP_TTL_S=5
IDLE_GAP_S=3
MAX_WINDOW_S=30

# Postgres (pgvector) - wired into compose, unused by app code in Week 1.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
