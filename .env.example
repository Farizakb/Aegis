# Secrets + tunables. Networking hostnames live in docker-compose.yml.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-4-5-20251001
PROPOSE_MODEL=claude-sonnet-4-6
HITL_TTL_S=600
# Optional: LangSmith LLM tracing
LANGCHAIN_TRACING_V2=false
